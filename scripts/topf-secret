#!/usr/bin/env -S usage bash
# vim:ft=bash
set -euo pipefail
#USAGE cmd "secrets" help="Manage topf secrets" {
#USAGE   cmd "get" help="Get a secret from the cluster" {
#USAGE     arg "<cluster>" help="Name of the cluster to operate on"
#USAGE   }
#USAGE   cmd "put" help="Set a secret for the cluster" {
#USAGE     arg "<cluster>" help="Name of the cluster to operate on"
#USAGE   }
#USAGE }

scripts_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
template_file="${scripts_dir}/topf-secret-bundle.yaml.optpl"

# inject the cluster's secrets into the template and print to stdout
get_secret() {
  export cluster="$1"
  envsubst < "${template_file}" | op inject
}

# take yaml from stdin and upsert the cluster's `talos-secrets` secret
set_secret() {
  local cluster="$1"
  local yaml="$(cat -)"

  local vault_name="cluster-${cluster}"
  if ! op vault list | grep -q "${vault_name}"; then
    echo "Vault ${vault_name} does not exist, creating it" > /dev/stderr
    op vault create "${vault_name}" >/dev/null
  fi

  get_key() {
    local key="$1"
    yq ".${key}" <<< "${yaml}"
  }

  # set each key in the yaml as a field in the 1Password item
  local -a data=(
    "password=dummy"
    "cluster.id=$(get_key cluster.id)"
    "cluster.secret=$(get_key cluster.secret)"
    "secrets.bootstrapToken=$(get_key secrets.bootstraptoken)"
    "secrets.secretboxEncryptionSecret=$(get_key secrets.secretboxencryptionsecret)"
    "trustdinfo.token=$(get_key trustdinfo.token)"
    "etcd.crt=$(get_key certs.etcd.crt)"
    "etcd.key=$(get_key certs.etcd.key)"
    "k8s.crt=$(get_key certs.k8s.crt)"
    "k8s.key=$(get_key certs.k8s.key)"
    "k8saggregator.crt=$(get_key certs.k8saggregator.crt)"
    "k8saggregator.key=$(get_key certs.k8saggregator.key)"
    "k8sserviceaccount.key=$(get_key certs.k8sserviceaccount.key)"
    "os.crt=$(get_key certs.os.crt)"
    "os.key=$(get_key certs.os.key)"
  )

  if ! op item list --vault "${vault_name}" | grep -q "talos-secrets"; then
    op item create --vault="${vault_name}" --category=password --title "talos-secrets" "${data[@]}" >/dev/null </dev/null
  else
    # update the existing item with the new data
    op item edit "talos-secrets" --vault="${vault_name}" "${data[@]}" >/dev/null </dev/null
  fi
}

case "$usage_cmd" in
  "secrets get") get_secret "${usage_cluster?}" ;;
  "secrets put") set_secret "${usage_cluster?}" ;;
esac
