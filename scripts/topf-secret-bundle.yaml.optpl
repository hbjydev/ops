# vim:ft=yaml
---
cluster:
  id: "op://cluster-${cluster}/talos-secrets/cluster/id"
  secret: "op://cluster-${cluster}/talos-secrets/cluster/secret"
secrets:
  bootstraptoken: "op://cluster-${cluster}/talos-secrets/secrets/bootstrapToken"
  secretboxencryptionsecret: "op://cluster-${cluster}/talos-secrets/secrets/secretboxEncryptionSecret"
trustdinfo:
  token: "op://cluster-${cluster}/talos-secrets/trustdinfo/token"
certs:
  etcd:
    crt: "op://cluster-${cluster}/talos-secrets/etcd/crt"
    key: "op://cluster-${cluster}/talos-secrets/etcd/key"
  k8s:
    crt: "op://cluster-${cluster}/talos-secrets/k8s/crt"
    key: "op://cluster-${cluster}/talos-secrets/k8s/key"
  k8saggregator:
    crt: "op://cluster-${cluster}/talos-secrets/k8saggregator/crt"
    key: "op://cluster-${cluster}/talos-secrets/k8saggregator/key"
  k8sserviceaccount:
    key: "op://cluster-${cluster}/talos-secrets/k8sserviceaccount/key"
  os:
    crt: "op://cluster-${cluster}/talos-secrets/os/crt"
    key: "op://cluster-${cluster}/talos-secrets/os/key"
