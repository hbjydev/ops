#!/usr/bin/env bash
# Render a build root without writing generated kustomization files into the repo.
set -euo pipefail

if [[ $# -ne 1 || ! -d "$1" ]]; then
  echo "usage: scripts/render-manifests <manifest-directory>" >&2
  exit 1
fi

config=$(mktemp)
trap 'rm -f "$config"' EXIT
cat > "$config" <<'YAML'
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: render
  namespace: flux-system
spec:
  interval: 1h
  prune: false
  sourceRef:
    kind: GitRepository
    name: flux-system
YAML

flux build kustomization render \
  --dry-run \
  --in-memory-build \
  --kustomization-file "$config" \
  --path "$1"
